{
  "name": "collab-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight collaborative document editor (Ajaia assignment)",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "test": "node --test server/test/api.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.13.0",
    "turndown": "^7.2.4"
  }
}
